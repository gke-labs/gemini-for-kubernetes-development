go 1.25.7

use (
	.
	./agentsandboxes
	./dev/tools
	./repo-agent
)

// We need this replace because repo-agent requires agentsandboxes using a pseudo-version
// (v0.0.0-00010101000000-000000000000) that does not exist in git history.
// While go.work 'use' should normally handle this, the go tool's version validation
// fails on this "zero" pseudo-version before applying workspace overrides.
// Removing this replace causes build failures with "invalid version: unknown revision 000000000000".
replace github.com/gke-labs/gemini-for-kubernetes-development/agentsandboxes v0.0.0-00010101000000-000000000000 => ./agentsandboxes
