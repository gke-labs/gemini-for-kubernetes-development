import requests
import subprocess
import time
import argparse
import os
import sys

# Hardcoded fallback version to use if GitHub API is unavailable (e.g. rate limited)
FALLBACK_VERSION = "0.1.0-rc.3"

def get_latest_agent_sandbox_version():
    """Fetches the latest Agent Sandbox version from the GitHub API."""
    # Allow override via environment variable
    env_version = os.getenv("AGENT_SANDBOX_VERSION")
    if env_version:
        print(f"Using Agent Sandbox version from environment: {env_version}")
        return env_version.lstrip("v")

    url = "https://api.github.com/repos/kubernetes-sigs/agent-sandbox/releases/latest"
    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        tag_name = response.json()["tag_name"]
        return tag_name.lstrip("v")
    except Exception as e:
        print(f"Warning: Failed to fetch latest Agent Sandbox version from GitHub: {e}")
        print(f"Falling back to hardcoded version: {FALLBACK_VERSION}")
        return FALLBACK_VERSION.lstrip("v")

def run_command(command):
    """Runs a shell command and prints its output."""
    print(f"Running command: {' '.join(command)}")
    subprocess.run(command, check=True)

def main():
    """Installs or uninstalls the latest version of Agent Sandbox."""
    parser = argparse.ArgumentParser(description="Installs or uninstalls Agent Sandbox.")
    parser.add_argument("--uninstall", action="store_true", help="Uninstall Agent Sandbox.")
    args = parser.parse_args()

    try:
        version = get_latest_agent_sandbox_version()

        if args.uninstall:
            print(f"Uninstalling agent-sandbox version: {version}")
            uninstall_command = [
                "kubectl", "delete", "--ignore-not-found", "-f",
                f"https://github.com/kubernetes-sigs/agent-sandbox/releases/download/v{version}/manifest.yaml"
            ]
            run_command(uninstall_command)
            print("Agent Sandbox uninstalled successfully.")
            return

        print(f"Installing agent-sandbox version: {version}")
 
        # kubectl apply -f https://github.com/kubernetes-sigs/agent-sandbox/releases/download/v0.1.0-rc.0/manifest.yaml
        install_command = [
            "kubectl", "apply", "-f",
            f"https://github.com/kubernetes-sigs/agent-sandbox/releases/download/v{version}/manifest.yaml"
        ]
        run_command(install_command)

        print("Waiting for 5 seconds...")
        time.sleep(5)

        kubectl_get_pods_command = ["kubectl", "get", "pods", "-n", "agent-sandbox-system"]
        run_command(kubectl_get_pods_command)

        print("Agent Sandbox installed successfully.")

    except subprocess.CalledProcessError as e:
        print(f"Error executing command: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"An unexpected error occurred: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()