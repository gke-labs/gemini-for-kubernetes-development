import subprocess
import sys
import argparse
import os

from shared import utils


def main():
    """ invokes go linter """
    # parse arguments and call
    parser = argparse.ArgumentParser(description="Invoke go linter")
    parser.add_argument("--working-dir",
                        dest="working_dir",
                        help="use working dir instead of repo root",
                        type=str,
                        default=None)
    args = parser.parse_args()

    repo_root = utils.get_repo_root()
    working_dir = args.working_dir or repo_root
    print(f"using working dir: {working_dir}")

    if working_dir == repo_root:
        # Find all workspace modules and lint each of them
        try:
            output = utils.check_output_go_command(["go", "list", "-m", "-f", "{{.Dir}}", "all"], cwd=repo_root, text=True)
            mod_dirs = [line.strip() for line in output.strip().split("\n") if line.strip().startswith(repo_root)]
        except Exception as e:
            print(f"Warning: failed to list workspace modules: {e}")
            mod_dirs = []

        exit_code = 0
        for mod_dir in mod_dirs:
            if mod_dir == repo_root:
                continue

            # Check if there are any .go files in this module
            has_go = False
            for root, dirs, files in os.walk(mod_dir):
                if any(f.endswith(".go") for f in files):
                    has_go = True
                    break
            if not has_go:
                continue

            print(f"Linting module: {mod_dir}")
            result = utils.run_go_command(utils.go_tool_args(
                "golangci-lint", "run",
                f"--config={repo_root}/dev/tools/.golangci.yaml",
            ), cwd=mod_dir)
            if result.returncode != 0:
                exit_code = result.returncode
        return exit_code
    else:
        result = utils.run_go_command(utils.go_tool_args(
            "golangci-lint", "run",
            f"--config={repo_root}/dev/tools/.golangci.yaml",
        ), cwd=working_dir)
        return result.returncode


if __name__ == "__main__":
    sys.exit(main())
